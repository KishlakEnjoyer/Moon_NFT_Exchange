BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# Standalone frontend + Cloudflared example.
BOT_FRONT_URL=https://moon-nft.ru
REACT_APP_FRONT_URL=https://moon-nft.ru
REACT_APP_FRONT_URL2=http://localhost:3000
REACT_APP_API_URL=https://api.moon-nft.ru
REACT_APP_IMAGES_URL=https://img.moon-nft.ru
REACT_APP_WS_URL=wss://api.moon-nft.ru
API_DOCKER_URL=http://backend:8000
CORS_ALLOWED_ORIGINS=https://moon-nft.ru,http://localhost:3000
RECSYS_RETRAIN_INTERVAL_SECONDS=10800
# Set to true only for a one-shot local retrain test.
RECSYS_RUN_ONCE=false
DB_HOST=YOUR_DB_HOST_HERE
DB_USER=YOUR_DB_USER_HERE
DB_PASSWORD=YOUR_DB_PASSWORD_HERE
DB_NAME=YOUR_DB_NAME_HERE
# Optional: one of these users will be promoted to role_id=4 (master_admin).
MASTER_ADMIN_USER_ID=
MASTER_ADMIN_TG_ID=
MASTER_ADMIN_USERNAME=
MASTER_WALLET_ADDRESS=0x_YOUR_ADDRESS
MASTER_WALLET_PRIVATE_KEY=0x_YOUR_KEY

# Gas Sponsorship Configuration
# Set to "true" to enable platform paying for user gas on gift purchases
GAS_SPONSOR_ENABLED=true
# Maximum gas price (in wei) the platform will pay per transaction (default: 50 gwei)
MAX_GAS_PRICE=50000000000
# Maximum daily gas budget for platform (in wei, default: 0.01 ETH = 10000000000000000)
MAX_DAILY_GAS_BUDGET=10000000000000000

MARKETPLACE_FEE_PERCENT=5
UPGRADE_PERCENT=25
REACT_APP_UPGRADE_PERCENT=25
BURN_REFUND_PERCENT=75
REACT_APP_BURN_REFUND_PERCENT=75

# YooKassa sandbox
YOOKASSA_TEST_MODE=true
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_TG_PROVIDER_TOKEN=
YOOKASSA_RETURN_URL=
# Configure YooKassa payment.succeeded/payment.canceled webhooks to:
# https://api.moon-nft.ru/topup/yookassa-webhook
TOPUP_RUB_PER_TON=100
TOPUP_MIN_AMOUNT=1
TOPUP_MAX_AMOUNT=10000
TOPUP_INTERNAL_SECRET=

# Profile text moderation
# Local link/profanity checks always run. If enabled, Hugging Face models are
# loaded locally through transformers on the first profile update.
PROFILE_CONTENT_HF_ENABLED=true
PROFILE_CONTENT_REQUIRE_HF=false
PROFILE_CONTENT_HF_MODELS=cointegrated/rubert-tiny-toxicity,martin-ha/toxic-comment-model
PROFILE_CONTENT_HF_THRESHOLD=0.75
PROFILE_CONTENT_HF_MAX_LENGTH=256
PROFILE_CONTENT_EN_FORBIDDEN_WORDS=bastard,bitch,bullshit,cocksucker,cunt,dickhead,faggot,fuck,fucked,fucker,fucking,motherfucker,nigger,pussy,shit,shitty,slut,whore,cannabis,cocaine,csam,drug,drugs,ecstasy,fentanyl,heroin,ketamine,lsd,marijuana,mdma,meth,narcotic,narcotics,opioid,opioids,pedo,pedophile,porn,porno,weed,xanax
PROFILE_CONTENT_EN_FORBIDDEN_PREFIXES=fuck,motherfuck,bullshit,drugdealer,drugshop,narcotic,pedophil
PROFILE_CONTENT_EN_FORBIDDEN_COMPACT=bitch,fuck,shit,buydrugs,childporn,childporno,childpornography,drugshere,kidsporn,selldrugs
